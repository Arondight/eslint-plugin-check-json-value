{
  "name": "eslint-plugin-check-json-value",
  "version": "2.1.2",
  "description": "ESLint plugin to check value of JSON file",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "eslint-plugin-check-json-value",
    "json"
  ],
  "author": "Qin Fandong",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arondight/eslint-plugin-check-json-value.git"
  },
  "bugs": {
    "url": "https://github.com/Arondight/eslint-plugin-check-json-value/issues"
  },
  "main": "lib/index.js",
  "files": ["lib"],
  "scripts": {
    "check": "npx eslint eslint.config.mjs ./.*.json ./lib/ ./tests/*.js ./tests/lib/rules/*.js",
    "format": "npx prettier --config ./.prettierrc.json -uw eslint.config.mjs ./.*.json ./*.md ./lib/ ./tests/*.js ./tests/lib/rules/*.js",
    "test": "npx cross-env-shell NODE_PATH=$INIT_CWD/.. mocha ./tests/lib/rules/"
  },
  "dependencies": {
    "@anchan828/json-ast": "^2.2.58",
    "lodash": "^4.18.1",
    "vscode-json-languageservice": "^5.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-eslint-plugin": "^7.6.0",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "eslint": ">=8.26.0"
  },
  "license": "MIT"
}
