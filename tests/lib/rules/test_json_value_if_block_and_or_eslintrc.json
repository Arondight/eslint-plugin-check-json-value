{
  "plugins": ["check-json-value"],
  "rules": {
    "check-json-value/json-value": [
      "error",
      [
        {
          "file": "test_json_value\\.json",
          "path": "data.records[0].id",
          "values": [
            {
              "type": "number",
              "value": 99999
            }
          ],
          "if": [
            {
              "block": "start"
            },
            {
              "path": "data.name",
              "values": [
                {
                  "type": "string",
                  "value": "^dog$"
                }
              ]
            },
            {
              "logic": "and"
            },
            {
              "path": "data.age",
              "values": [
                {
                  "type": "number",
                  "value": 100
                }
              ]
            },
            {
              "block": "end"
            },
            {
              "logic": "or"
            },
            {
              "path": "data.records[0].id",
              "values": [
                {
                  "type": "number",
                  "value": 10000
                }
              ]
            }
          ]
        }
      ]
    ]
  }
}
